<Window x:Class="ErwinStudioSample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Data Architect Studio — Sales Model" Height="850" Width="1440"
        MinHeight="650" MinWidth="1080" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Canvas}" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <DrawingBrush x:Key="DiagramGridBrush" TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute"><DrawingBrush.Drawing><GeometryDrawing Brush="#0D1520"><GeometryDrawing.Pen><Pen Brush="#182535" Thickness="1"/></GeometryDrawing.Pen><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,20,20"/></GeometryDrawing.Geometry></GeometryDrawing></DrawingBrush.Drawing></DrawingBrush>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedInk}"/><Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>
        <Style x:Key="EntityCard" TargetType="Border">
            <Setter Property="Background" Value="#202B3A"/><Setter Property="BorderBrush" Value="#33465A"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.12"/></Setter.Value></Setter>
        </Style>
    <Style x:Key="CardResizeThumb" TargetType="primitives:Thumb"><Setter Property="Width" Value="18"/><Setter Property="Height" Value="18"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Bottom"/><Setter Property="Margin" Value="0,0,3,3"/><Setter Property="Cursor" Value="SizeNWSE"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="primitives:Thumb"><Grid Background="Transparent"><Path Stroke="#AFC3D2" StrokeThickness="1.5" Data="M 5,15 L 15,5 M 10,15 L 15,10 M 14,15 L 15,14"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="DiagramToolButton" TargetType="Button">
            <Setter Property="MinWidth" Value="88"/><Setter Property="Height" Value="108"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="6"/>
            <Setter Property="Foreground" Value="#B9D9FF"/><Setter Property="Background" Value="#314866"/><Setter Property="BorderBrush" Value="#3B5576"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="6">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border x:Name="IconTile" Width="30" Height="30" CornerRadius="7" Background="#13283F" HorizontalAlignment="Center" Margin="0,0,0,5">
                            <TextBlock x:Name="ToolIcon" Text="{TemplateBinding Tag}" Foreground="#B9D9FF" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="120" MinHeight="34"/>
                    </StackPanel>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Card" Property="Background" Value="#3A526F"/><Setter TargetName="Card" Property="BorderBrush" Value="#62E6B3"/>
                        <Setter TargetName="IconTile" Property="Background" Value="#102F35"/><Setter TargetName="ToolIcon" Property="Foreground" Value="#69F0AE"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Card" Property="Background" Value="#29445B"/><Setter TargetName="ToolIcon" Property="Foreground" Value="#A7FFD1"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#62E6B3"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="26"/></Grid.RowDefinitions>

        <!-- Menu strip -->
        <Border Grid.Row="0" Background="#152E3A">
            <DockPanel Margin="14,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Border Background="{StaticResource Accent}" Width="28" Height="28" CornerRadius="5" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="D" Foreground="White" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="DATA ARCHITECT" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0"/>
                    <Button Foreground="#E7EDF0" Content="File"/><Button Foreground="#E7EDF0" Content="Edit"/><Button Foreground="#E7EDF0" Content="View"/>
                    <Button Foreground="#E7EDF0" Content="Model"/><Button Foreground="#E7EDF0" Content="Database"/><Button Foreground="#E7EDF0" Content="Tools"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock Text="Sales Model  •  Modified" Foreground="#B8C7CE" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Border Background="#244653" CornerRadius="14" Padding="10,5" VerticalAlignment="Center"><TextBlock Text="KW" Foreground="White" FontWeight="SemiBold"/></Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Command bar -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1">
            <DockPanel Margin="10,5">
                <StackPanel Orientation="Horizontal">
                    <Button Click="NewEntity_Click" ToolTip="Add entity"><StackPanel Orientation="Horizontal"><TextBlock Text="＋" Foreground="{StaticResource Accent}" FontSize="19"/><TextBlock Text=" Entity" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button Click="AddRelationship_Click" ToolTip="Add relationship"><StackPanel Orientation="Horizontal"><TextBlock Text="⌁" Foreground="{StaticResource Accent}" FontSize="19"/><TextBlock Text=" Relationship" VerticalAlignment="Center"/></StackPanel></Button>
                    <Separator Margin="7,5"/>
                    <Button Content="↶" FontSize="18" ToolTip="Undo"/><Button Content="↷" FontSize="18" ToolTip="Redo"/>
                    <Separator Margin="7,5"/>
                    <Button Click="Validate_Click" Content="✓  Validate"/><Button Click="Generate_Click" Content="⌘  Generate DDL"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Border Background="#F2F5F7" CornerRadius="4" Padding="8,4" Margin="4,0"><TextBlock Text="Logical / Physical" Foreground="{StaticResource MutedInk}"/></Border>
                    <Button Content="−" Click="ZoomOut_Click"/><TextBlock x:Name="ZoomLabel" Text="100%" Width="45" TextAlignment="Center" VerticalAlignment="Center"/><Button Content="＋" Click="ZoomIn_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>

            <!-- Explorer -->
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource Rule}" BorderThickness="0,0,1,0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="MODEL EXPLORER" Style="{StaticResource SectionTitle}" Margin="14,0" VerticalAlignment="Center"/>
                    <Border Grid.Row="1" Background="#F5F7F9" CornerRadius="4" Margin="10,3" Padding="8,0">
                        <DockPanel><TextBlock Text="⌕" FontSize="17" VerticalAlignment="Center"/><TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" BorderThickness="0" Background="Transparent" Margin="6,0" VerticalContentAlignment="Center" ToolTip="Filter objects"/></DockPanel>
                    </Border>
                    <TreeView x:Name="ModelTree" Grid.Row="2" BorderThickness="0" Padding="7,6" SelectedItemChanged="ModelTree_SelectedItemChanged">
                        <TreeViewItem Header="▾  Sales Model" IsExpanded="True">
                            <TreeViewItem Header="▾  Entities (5)" IsExpanded="True">
                                <TreeViewItem Header="▤  Customer" Tag="Customer"/>
                                <TreeViewItem Header="▤  Order" Tag="Order"/>
                                <TreeViewItem Header="▤  Order Item" Tag="OrderItem"/>
                                <TreeViewItem Header="▤  Product" Tag="Product"/>
                                <TreeViewItem Header="▤  Category" Tag="Category"/>
                            </TreeViewItem>
                            <TreeViewItem Header="◇  Relationships (4)"/>
                            <TreeViewItem Header="▱  Domains (3)"/>
                            <TreeViewItem Header="⚿  Indexes (7)"/>
                        </TreeViewItem>
                    </TreeView>
                    <Border Grid.Row="3" Background="#132231" BorderBrush="#294055" BorderThickness="0,1,0,0" Padding="8,10,8,12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="440">
                            <StackPanel>
                                <TextBlock Text="Diagram Box" Foreground="#8FC8FF" FontSize="14" Margin="4,0,0,7"/>
                                <UniformGrid Columns="2">
                                    <Button Style="{StaticResource DiagramToolButton}" Tag="▦" Content="Entity" ToolTip="Entity" Click="DiagramTool_Click"/>
                                    <Button Style="{StaticResource DiagramToolButton}" Tag="≡" Content="Annotation" ToolTip="Annotation" Click="DiagramTool_Click"/>
                                    <Button Style="{StaticResource DiagramToolButton}" Tag="▧" Content="View" ToolTip="View" Click="DiagramTool_Click"/>
                                    <Button Style="{StaticResource DiagramToolButton}" Tag="♧" Content="Materialized View" ToolTip="Materialized View" Click="DiagramTool_Click"/>
                                    <Button Style="{StaticResource DiagramToolButton}" Tag="↘" Content="Identifying" ToolTip="Identifying relationship" Click="DiagramTool_Click"/>
                                    <Button Style="{StaticResource DiagramToolButton}" Tag="→" Content="Non-identifying" ToolTip="Non-identifying relationship" Click="DiagramTool_Click"/>
                                    <Button Style="{StaticResource DiagramToolButton}" Tag="⋯" Content="View/Materialized Rel." ToolTip="View relationship" Click="DiagramTool_Click"/>
                                </UniformGrid>
                                <TextBlock Text="Drawing Box" Foreground="#8FC8FF" FontSize="14" Margin="4,8,0,7"/>
                                <UniformGrid Columns="2"><Button Style="{StaticResource DiagramToolButton}" Tag="◇" Content="Drawing" ToolTip="Drawing" Click="DiagramTool_Click"/></UniformGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#EDF1F4"/>

            <!-- Diagram -->
            <Grid Grid.Column="2" Background="#F4F6F8">
                <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="White" BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1">
                    <DockPanel><TextBlock Text="Sales Overview" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0"/><TextBlock DockPanel.Dock="Right" Text="Diagram 1" Foreground="{StaticResource MutedInk}" VerticalAlignment="Center" Margin="0,0,14,0"/></DockPanel>
                </Border>
                <ScrollViewer x:Name="DiagramScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{StaticResource DiagramGridBrush}" SizeChanged="DiagramScrollViewer_SizeChanged">
                    <Grid x:Name="DiagramView" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Canvas x:Name="DiagramCanvasSurface" MinWidth="930" MinHeight="650" Background="{StaticResource DiagramGridBrush}" MouseLeftButtonDown="DiagramCanvasSurface_MouseLeftButtonDown">
                            <!-- relation lines -->
                            <Path Tag="CustomerOrder" Stroke="Transparent" StrokeThickness="16" Data="M 265,158 L 330,158 L 330,245 L 390,245" MouseLeftButtonDown="Relationship_MouseLeftButtonDown" MouseMove="RelationshipHit_MouseMove" MouseLeftButtonUp="RelationshipHit_MouseLeftButtonUp" Cursor="SizeAll"/>
                            <Path x:Name="CustomerOrderLine" Tag="CustomerOrder" Stroke="#42D9D4" StrokeThickness="2.5" StrokeDashArray="2,1.5" StrokeDashCap="Round" Data="M 265,158 L 330,158 L 330,245 L 390,245" IsHitTestVisible="False"/>
                            <Path Tag="OrderProduct" Stroke="Transparent" StrokeThickness="16" Data="M 610,245 L 665,245 L 665,158 L 720,158" MouseLeftButtonDown="Relationship_MouseLeftButtonDown" MouseMove="RelationshipHit_MouseMove" MouseLeftButtonUp="RelationshipHit_MouseLeftButtonUp" Cursor="SizeAll"/>
                            <Path x:Name="OrderProductLine" Tag="OrderProduct" Stroke="#42D9D4" StrokeThickness="2.5" Data="M 610,245 L 665,245 L 665,158 L 720,158" IsHitTestVisible="False"/>
                            <Path Tag="OrderOrderItem" Stroke="Transparent" StrokeThickness="16" Data="M 500,330 L 500,390" MouseLeftButtonDown="Relationship_MouseLeftButtonDown" MouseMove="RelationshipHit_MouseMove" MouseLeftButtonUp="RelationshipHit_MouseLeftButtonUp" Cursor="SizeAll"/>
                            <Path x:Name="OrderOrderItemLine" Tag="OrderOrderItem" Stroke="#42D9D4" StrokeThickness="2.5" Data="M 500,330 L 500,390" IsHitTestVisible="False"/>
                            <Path Tag="ProductOrderItem" Stroke="Transparent" StrokeThickness="16" Data="M 720,170 L 680,170 L 680,485 L 610,485" MouseLeftButtonDown="Relationship_MouseLeftButtonDown" MouseMove="RelationshipHit_MouseMove" MouseLeftButtonUp="RelationshipHit_MouseLeftButtonUp" Cursor="SizeAll"/>
                            <Path x:Name="ProductOrderItemLine" Tag="ProductOrderItem" Stroke="#42D9D4" StrokeThickness="2.5" StrokeDashArray="2,1.5" StrokeDashCap="Round" Data="M 720,170 L 680,170 L 680,485 L 610,485" IsHitTestVisible="False"/>

                            

                            

                            

                            
                            <Border x:Name="CustomerCard" Canvas.Left="45" Canvas.Top="65" Width="220" Height="190" Style="{StaticResource EntityCard}" MouseLeftButtonDown="Entity_MouseLeftButtonDown" MouseMove="Entity_MouseMove" MouseLeftButtonUp="Entity_MouseLeftButtonUp" Tag="Customer"><Grid TextElement.Foreground="#DCE7F5"><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="#087E8B" CornerRadius="6,6,0,0"><TextBlock Text="CUSTOMER" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0"/></Border><StackPanel Grid.Row="1" Margin="10,7"><TextBlock Text="🔑  customer_id        INT" FontWeight="SemiBold" Margin="0,3"/><Separator/><TextBlock Text="     first_name          VARCHAR(50)" Margin="0,3"/><TextBlock Text="     last_name           VARCHAR(50)" Margin="0,3"/><TextBlock Text="     email                   VARCHAR(120)" Margin="0,3"/><TextBlock Text="     created_at          DATETIME" Margin="0,3"/></StackPanel><primitives:Thumb Grid.RowSpan="2" Style="{StaticResource CardResizeThumb}" Tag="Customer" DragStarted="ResizeThumb_DragStarted" DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted"/></Grid></Border>
                            <Border x:Name="OrderCard" Canvas.Left="390" Canvas.Top="150" Width="220" Height="180" Style="{StaticResource EntityCard}" MouseLeftButtonDown="Entity_MouseLeftButtonDown" MouseMove="Entity_MouseMove" MouseLeftButtonUp="Entity_MouseLeftButtonUp" Tag="Order"><Grid TextElement.Foreground="#DCE7F5"><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="#3D5260" CornerRadius="6,6,0,0"><TextBlock Text="ORDER" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0"/></Border><StackPanel Grid.Row="1" Margin="10,7"><TextBlock Text="🔑  order_id             INT" FontWeight="SemiBold" Margin="0,3"/><Separator/><TextBlock Text="🔗  customer_id       INT" Margin="0,3"/><TextBlock Text="     order_date          DATETIME" Margin="0,3"/><TextBlock Text="     status                  VARCHAR(20)" Margin="0,3"/></StackPanel><primitives:Thumb Grid.RowSpan="2" Style="{StaticResource CardResizeThumb}" Tag="Order" DragStarted="ResizeThumb_DragStarted" DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted"/></Grid></Border>
                            <Border x:Name="ProductCard" Canvas.Left="720" Canvas.Top="65" Width="185" Height="190" Style="{StaticResource EntityCard}" MouseLeftButtonDown="Entity_MouseLeftButtonDown" MouseMove="Entity_MouseMove" MouseLeftButtonUp="Entity_MouseLeftButtonUp" Tag="Product"><Grid TextElement.Foreground="#DCE7F5"><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="#087E8B" CornerRadius="6,6,0,0"><TextBlock Text="PRODUCT" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0"/></Border><StackPanel Grid.Row="1" Margin="10,7"><TextBlock Text="🔑  product_id     INT" FontWeight="SemiBold" Margin="0,3"/><Separator/><TextBlock Text="🔗  category_id  INT" Margin="0,3"/><TextBlock Text="     name              VARCHAR(100)" Margin="0,3"/><TextBlock Text="     unit_price       DECIMAL" Margin="0,3"/></StackPanel><primitives:Thumb Grid.RowSpan="2" Style="{StaticResource CardResizeThumb}" Tag="Product" DragStarted="ResizeThumb_DragStarted" DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted"/></Grid></Border>
                            <Border x:Name="OrderItemCard" Canvas.Left="390" Canvas.Top="390" Width="220" Height="190" Style="{StaticResource EntityCard}" MouseLeftButtonDown="Entity_MouseLeftButtonDown" MouseMove="Entity_MouseMove" MouseLeftButtonUp="Entity_MouseLeftButtonUp" Tag="OrderItem"><Grid TextElement.Foreground="#DCE7F5"><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="#3D5260" CornerRadius="6,6,0,0"><TextBlock Text="ORDER ITEM" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0"/></Border><StackPanel Grid.Row="1" Margin="10,7"><TextBlock Text="🔑  order_item_id     INT" FontWeight="SemiBold" Margin="0,3"/><Separator/><TextBlock Text="🔗  order_id                INT" Margin="0,3"/><TextBlock Text="🔗  product_id            INT" Margin="0,3"/><TextBlock Text="     quantity                 INT" Margin="0,3"/></StackPanel><primitives:Thumb Grid.RowSpan="2" Style="{StaticResource CardResizeThumb}" Tag="OrderItem" DragStarted="ResizeThumb_DragStarted" DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted"/></Grid></Border>
<Button x:Name="RelationshipDeleteButton" Visibility="Collapsed" Width="26" Height="26" Padding="0" Content="×" Background="#F06D82" Foreground="#07111B" BorderBrush="#FF91A2" BorderThickness="1" FontSize="17" FontWeight="Bold" Cursor="Hand" Click="RelationshipDeleteButton_Click" Panel.ZIndex="22" ToolTip="Remove relationship"/>
                            <Ellipse x:Name="RelationshipMoveHandle" Visibility="Collapsed" Width="18" Height="18" Fill="#F1BF52" Stroke="#FFF1A8" StrokeThickness="2" Cursor="SizeAll" MouseLeftButtonDown="RelationshipHandle_MouseLeftButtonDown" MouseMove="RelationshipHandle_MouseMove" MouseLeftButtonUp="RelationshipHandle_MouseLeftButtonUp" Panel.ZIndex="20" ToolTip="Drag to move selected relationship"/>
                            <TextBlock x:Name="EmptyHint" Visibility="Collapsed" Canvas.Left="365" Canvas.Top="300" Text="No matching entities" Foreground="{StaticResource MutedInk}" FontSize="18"/>
                        </Canvas>
                    </Grid>
                </ScrollViewer>
            </Grid>
            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#EDF1F4"/>

            <!-- Properties -->
            <Border Grid.Column="4" Background="White" BorderBrush="{StaticResource Rule}" BorderThickness="1,0,0,0">
                <ScrollViewer><Grid>
                <StackPanel x:Name="EntityPropertiesPanel">
                    <TextBlock Text="PROPERTIES" Style="{StaticResource SectionTitle}" Margin="14,14,14,10"/>
                    <Border Background="#EFF7F8" Padding="14,12" BorderBrush="#CFE3E6" BorderThickness="0,1"><StackPanel><TextBlock x:Name="SelectedEntityTitle" Text="ORDER" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AccentDark}"/><TextBlock Text="Entity" Foreground="{StaticResource MutedInk}" Margin="0,2,0,0"/></StackPanel></Border>
                    <TextBlock Text="GENERAL" Style="{StaticResource SectionTitle}" Margin="14,18,14,8"/>
                    <TextBlock Text="Name" Foreground="{StaticResource MutedInk}" Margin="14,3"/><TextBox x:Name="EntityNameBox" Text="Order" Margin="14,0,14,8" Padding="7,5" BorderBrush="{StaticResource Rule}" LostFocus="EntityNameBox_LostFocus"/>
                    <TextBlock Text="Physical name" Foreground="{StaticResource MutedInk}" Margin="14,3"/><TextBox x:Name="PhysicalNameBox" Text="sales_order" Margin="14,0,14,8" Padding="7,5" BorderBrush="{StaticResource Rule}"/>
                    <TextBlock Text="Definition" Foreground="{StaticResource MutedInk}" Margin="14,3"/><TextBox Text="Customer purchase transaction." Height="62" TextWrapping="Wrap" AcceptsReturn="True" Margin="14,0,14,8" Padding="7,5" BorderBrush="{StaticResource Rule}"/>
                    <TextBlock Text="COLUMNS" Style="{StaticResource SectionTitle}" Margin="14,18,14,8"/>
                    <DataGrid x:Name="ColumnsGrid" Margin="10,0" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeaderWidth="0"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="92"/><DataGridCheckBoxColumn Header="NN" Binding="{Binding Required}" Width="36"/></DataGrid.Columns></DataGrid>
                    <Button Content="＋  Add column" HorizontalAlignment="Left" Margin="8,6" Click="AddColumn_Click" Foreground="{StaticResource AccentDark}"/>
                </StackPanel>
                <StackPanel x:Name="RelationshipPropertiesPanel" Visibility="Collapsed">
                    <TextBlock Text="RELATIONSHIP PROPERTIES" Style="{StaticResource SectionTitle}" Margin="14,14,14,10"/>
                    <Border Background="#EFF7F8" Padding="14,12" BorderBrush="#CFE3E6" BorderThickness="0,1"><StackPanel><TextBlock x:Name="SelectedRelationshipTitle" Text="RELATIONSHIP" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AccentDark}"/><TextBlock Text="Relationship" Foreground="{StaticResource MutedInk}" Margin="0,2,0,0"/></StackPanel></Border>
                    <TextBlock Text="Name" Foreground="{StaticResource MutedInk}" Margin="14,14,14,3"/><TextBox x:Name="RelationshipNameBox" Margin="14,0,14,8" Padding="7,5" BorderBrush="{StaticResource Rule}"/>
                    <TextBlock Text="Physical name" Foreground="{StaticResource MutedInk}" Margin="14,3"/><TextBox x:Name="RelationshipPhysicalNameBox" Margin="14,0,14,8" Padding="7,5" BorderBrush="{StaticResource Rule}"/>
                    <TextBlock Text="Description" Foreground="{StaticResource MutedInk}" Margin="14,3"/><TextBox x:Name="RelationshipDescriptionBox" Text="contains" Margin="14,0,14,8" Padding="7,5" BorderBrush="{StaticResource Rule}"/>
                    <TextBlock Text="Parent object" Foreground="{StaticResource MutedInk}" Margin="14,3"/><TextBox x:Name="RelationshipParentBox" IsReadOnly="True" Margin="14,0,14,8" Padding="7,5" BorderBrush="{StaticResource Rule}"/>
                    <TextBlock Text="Child object" Foreground="{StaticResource MutedInk}" Margin="14,3"/><TextBox x:Name="RelationshipChildBox" IsReadOnly="True" Margin="14,0,14,8" Padding="7,5" BorderBrush="{StaticResource Rule}"/>
                    <TextBlock Text="Cardinality" Foreground="{StaticResource MutedInk}" Margin="14,3"/><ComboBox x:Name="CardinalityComboBox" Margin="14,0,14,8" Padding="7,5" SelectedValuePath="Content" SelectionChanged="CardinalityComboBox_SelectionChanged"><ComboBoxItem Content="1:1"/><ComboBoxItem Content="1:N"/><ComboBoxItem Content="N:1"/><ComboBoxItem Content="N:N"/></ComboBox>
                    <TextBlock Text="Relationship type" Foreground="{StaticResource MutedInk}" Margin="14,3"/><TextBox x:Name="RelationshipTypeBox" IsReadOnly="True" Margin="14,0,14,12" Padding="7,5" BorderBrush="{StaticResource Rule}"/>
                    <Button Content="Delete Relationship" Click="DeleteSelectedRelationship_Click" Background="#F06D82" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Left" Margin="14,4" Padding="14,8"/>
                </StackPanel>
                </Grid></ScrollViewer>
            </Border>        </Grid>

        <Border Grid.Row="3" Background="#E9EEF1" BorderBrush="#D0D9DF" BorderThickness="0,1,0,0">
            <DockPanel Margin="10,0"><TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center" Foreground="{StaticResource MutedInk}"/><TextBlock DockPanel.Dock="Right" Text="5 entities   •   4 relationships   •   SQL Server 2022" VerticalAlignment="Center" Foreground="{StaticResource MutedInk}"/></DockPanel>
        </Border>
    </Grid>
</Window>
